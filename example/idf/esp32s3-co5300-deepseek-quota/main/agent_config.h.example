#pragma once

/*
 * Copy this file to agent_config.h, then fill in your local values.
 * agent_config.h is ignored by Git and must never be committed.
 */

#define AGENT_WIFI_SSID ""
#define AGENT_WIFI_PASSWORD ""

/* DeepSeek user balance API. Keep the API key local. */
#define AGENT_API_KEY ""
#define AGENT_BALANCE_URL "https://api.deepseek.com/user/balance"
#define AGENT_MODEL_NAME "deepseek-chat"
#define AGENT_DISPLAY_NAME "DEEPSEEK AGENT"

/* 0: blue/white instrument theme, 1: airport yellow/gray theme. */
#define AGENT_THEME_AIRPORT 0

/* Minimum recommended interval is 300 seconds to avoid needless API calls. */
#define AGENT_POLL_INTERVAL_SECONDS 300
