#define AGENT_BALANCE_URL "https://api.deepseek.com/user/balance"
#define AGENT_PROVIDER_NAME "DeepSeek"
#define AGENT_MODEL_NAME "deepseek-chat"
#define AGENT_DISPLAY_NAME "DEEPSEEK AGENT"
